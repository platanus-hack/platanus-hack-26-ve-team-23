{
  // Your project's name, as it will appear on the voting page.
  "project-name": "HAWK",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Un equipo aparte revisa cada acción de tus agentes de IA antes de que se ejecute y guarda un registro que el agente no puede reescribir.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "HAWK (Hardware Autonomous Watcher & Keeper) es un monitor para agentes de programación que corre en un equipo dedicado, como una Raspberry Pi, nunca en la máquina que vigila. Claude Code, Codex y OpenCode le preguntan antes de cada herramienta: HAWK aplica sus reglas y permite, te pregunta en el teléfono o niega, y ante una acción crítica le pide al router OpenWrt o MikroTik que aísle la máquina. Si HAWK no responde, la acción no se ejecuta. Cada decisión queda sellada con la llave de tu teléfono, encadenada y firmada con Ed25519 y ML-DSA-65, y la app verifica el registro. Funciona sin internet.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://hawkeeper.xyz"
}
